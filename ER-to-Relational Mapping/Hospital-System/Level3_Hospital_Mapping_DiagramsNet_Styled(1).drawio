        <mxCell id="r20_2" value="Needed if service prices change over time." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1">
