        <mxCell id="r17_0" value="Appointment ↔ Bill" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="70" y="1046" width="430" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r17_1" value="0..1 Relationship" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="500" y="1046" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r17_2" value="Base model allows at most one summarized bill." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="980" y="1046" width="1160" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r18_0" value="Department ↔ Service" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="70" y="1098" width="430" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r18_1" value="M:N Modeling Choice" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="500" y="1098" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r18_2" value="Brief says offers services but does not fix ownership." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="980" y="1098" width="1160" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r19_0" value="Payment" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="70" y="1150" width="430" height="52" as="geometry" />
