        <mxCell id="r19_1" value="Improvement Entity" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="500" y="1150" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r19_2" value="Needed for partial/multiple payments." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="980" y="1150" width="1160" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r20_0" value="Service Price History" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1">
