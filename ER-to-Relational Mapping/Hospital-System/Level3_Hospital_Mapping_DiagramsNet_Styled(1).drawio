  <diagram id="p3" name="3 - Behavior + Improvements">
    <mxGraphModel pageWidth="2250" pageHeight="1450">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d6e4ef;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="2200" height="1320" as="geometry" />
        </mxCell>
        <mxCell id="title" value="System Behavior Analysis + Design Improvements" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=27;" vertex="1" parent="1">
          <mxGeometry x="520" y="15" width="1200" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p0" value="Appointment Cancellation&#xa;Keep the appointment row and set status = CANCELLED. Do not hard-delete audit history. Planned services can be removed or marked not-performed according to policy." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="980" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="Doctor Leaving&#xa;Do not delete the Doctor because historical Appointments and Medical Records depend on it. Add is_active or employment_end_date and reassign/cancel future appointments." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="130" width="980" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="Partial Payments&#xa;Core BILL is insufficient for several partial payments. Add PAYMENT(payment_id, bill_id, amount, payment_date, method, status). Then BILL 1:N PAYMENT." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="390" width="980" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="Service Price Changes&#xa;Historical bills must not change when SERVICE.price changes. Store unit_price_at_use in APPOINTMENT_SERVICE or add BILL_ITEM / SERVICE_PRICE_HISTORY." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="390" width="980" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="Department Head Rule&#xa;Base design keeps head_doctor_id nullable. If every department must have a head, make it NOT NULL. If one doctor can head at most one department, add UNIQUE(head_doctor_id)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="680" width="980" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="Appointment Without Services&#xa;Base design allows 0..N services because the brief is undefined. If the client requires at least one service, enforce it as a business rule." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="680" width="980" height="220" as="geometry" />
        </mxCell>
        <mxCell id="imp" value="Recommended Improvement Entities&#xa;PAYMENT — partial/multiple payments. | BILL_ITEM — freeze billed service details and historical unit price. | SERVICE_PRICE_HISTORY — track price changes. | Doctor activity/employment status — preserve history when doctors leave. | Optional APPOINTMENT_SERVICE.status — planned vs delivered." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#eefcf4;strokeColor=#86efac;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="950" width="2030" height="260" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
