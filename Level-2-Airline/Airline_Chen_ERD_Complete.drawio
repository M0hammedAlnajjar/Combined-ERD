        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;RESERVATION: ONE ASSOCIATION, THREE PARTICIPANTS&lt;/b&gt;&lt;br&gt;Each reservation connects one CUSTOMER, one SEAT and one LEG_INSTANCE.&lt;br&gt;The ternary association is represented as a weak associative entity (reified relationship).&lt;br&gt;The reserved seat must belong to the airplane assigned to that leg instance." style="text;align=left;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#20364D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1630" width="1250" height="150" />
        </mxCell>
        <mxCell id="keys" value="&lt;b&gt;IDENTIFIERS &amp; ASSUMPTIONS&lt;/b&gt;&lt;br&gt;LEG_INSTANCE: (Leg_no, Flight_date). One occurrence per leg per date.&lt;br&gt;RESERVATION: (Leg_no, Flight_date, Seat_no); no double booking.&lt;br&gt;SEAT: (Airplane_id, Seat_no). FARE: (Flight_no, Fare_code).&lt;br&gt;Leg_no is globally unique. Customer_id is an added identifier." style="text;align=left;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#20364D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="1630" width="1170" height="160" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;CHEN NOTATION&lt;/b&gt; · Double rectangle: weak entity · Double diamond: identifying relationship · Double line: total participation&lt;br&gt;Underline: key · Dashed underline: partial key · Double oval: multivalued attribute · 1 : M = one-to-many · M : N = many-to-many" style="text;align=left;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#20364D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1830" width="2480" height="80" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
