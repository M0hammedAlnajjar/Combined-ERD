        <mxCell id="text_1" value="M:N resolution: APPOINTMENT_SERVICE is the bridge.&lt;br&gt;Quantity and Unit_price_at_use belong here." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D9B300;strokeWidth=2;fontSize=15;fontColor=#243B53;" vertex="1" parent="1">
