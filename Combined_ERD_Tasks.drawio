        <mxCell id="text_2" value="Assumption: each SUBJECT belongs to one COURSE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D9B300;strokeWidth=2;fontSize=14;fontColor=#243B53;" vertex="1" parent="1">
