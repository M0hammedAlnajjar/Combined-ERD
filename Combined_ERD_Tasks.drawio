        </mxCell>
        <mxCell id="text_2" value="Historical price: SERVICE_PRICE_HISTORY stores effective periods;&lt;br&gt;old charges retain Unit_price_at_use." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D9B300;strokeWidth=2;fontSize=14;fontColor=#243B53;" vertex="1" parent="1">
          <mxGeometry x="490" y="4145" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="text_3" value="Partial payments: one BILLING record can have many PAYMENT rows;&lt;br&gt;Balance_due is derived." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D9B300;strokeWidth=2;fontSize=15;fontColor=#243B53;" vertex="1" parent="1">
