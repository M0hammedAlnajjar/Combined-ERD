        <mxCell id="text_1" value="Ternary rule: CUSTOMER reserves a SEAT for one LEG_INSTANCE.&lt;br&gt;The pair (LEG_INSTANCE, SEAT) must be unique." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D9B300;strokeWidth=2;fontSize=15;fontColor=#243B53;" vertex="1" parent="1">
          <mxGeometry x="2910" y="3245" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="text_2" value="Validation: the reserved SEAT must belong to the AIRPLANE&lt;br&gt;assigned to that LEG_INSTANCE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D9B300;strokeWidth=2;fontSize=15;fontColor=#243B53;" vertex="1" parent="1">
          <mxGeometry x="4060" y="3245" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="text_3" value="Introduced safe identifiers: Flight_no and Customer_id." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D9B300;strokeWidth=2;fontSize=15;fontColor=#243B53;" vertex="1" parent="1">
